# Local SQLite (works now without Docker)
DATABASE_URL="file:./dev.db"
AUTH_SECRET="rezist-dev-secret-change-in-production"

# When Docker Desktop is installed, switch to Postgres for industrial scale:
# 1) docker compose up -d
# 2) In prisma/schema.prisma set provider = "postgresql"
# 3) DATABASE_URL="postgresql://rezist:rezist@localhost:5432/rezist"
# 4) npm run db:setup
