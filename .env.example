# Local SQLite (works on this Windows host without Docker)
DATABASE_URL="file:./dev.db"
AUTH_SECRET="rezist-dev-secret-change-in-production"

# ——— Vercel / production ———
# SQLite does NOT work on Vercel serverless.
# 1) Create a free Postgres (Neon https://neon.tech or Prisma https://console.prisma.io)
# 2) In Vercel → Project → Settings → Environment Variables add:
#      DATABASE_URL = your postgres connection string (pooled URL is fine)
#      AUTH_SECRET  = long random string
# 3) In prisma/schema.prisma set:  provider = "postgresql"
# 4) Redeploy. Then run once (locally against that URL): npm run db:setup
#
# Optional local Postgres via Docker Desktop:
# 1) docker compose up -d
# 2) provider = "postgresql"
# 3) DATABASE_URL="postgresql://rezist:rezist@localhost:5432/rezist"
# 4) npm run db:setup
