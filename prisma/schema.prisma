generator client {
  provider      = "prisma-client-js"
  // native = local Windows/Mac; rhel = Vercel Node serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// Local default remains SQLite. For Vercel, set provider to postgresql
// and DATABASE_URL to Neon / Prisma Postgres / Vercel Postgres (SQLite cannot run on Vercel).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  managerPinHash String?
  role           String   @default("CASHIER")
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales           Sale[]
  dayCloses       DayClose[]
  productions     ProductionBatch[]
  wastage         WastageRecord[]
  transfersOut    StockTransfer[]  @relation("TransferCreatedBy")
  transfersShip   StockTransfer[]  @relation("TransferShippedBy")
  transfersRecv   StockTransfer[]  @relation("TransferReceivedBy")
  purchases       PurchaseOrder[]  @relation("PurchaseCreatedBy")
  purchasesRecv   PurchaseOrder[]  @relation("PurchaseReceivedBy")
  auditLogs       AuditLog[]
  shifts          PosShift[]
  attendance      Attendance[]
  promotions      Promotion[]      @relation("PromotionCreatedBy")
  qualityChecks   QualityCheck[]
  payrollStubs    PayrollStub[]
  handoversFrom   ShiftHandover[] @relation("HandoverFrom")
  handoversTo     ShiftHandover[] @relation("HandoverTo")
  notificationsRead OpsNotification[] @relation("NotificationReader")
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String
  address   String
  phone     String?
  type      String   @default("RETAIL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  inventory      InventoryItem[]
  lots           InventoryLot[]
  priceOverrides PriceOverride[]
  sales          Sale[]
  dayCloses      DayClose[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  productions    ProductionBatch[]
  wastage        WastageRecord[]
  onlineOrders   OnlineOrder[]
  purchases      PurchaseOrder[]
  shifts         PosShift[]
  attendance     Attendance[]
  promotions     Promotion[]
  customers      Customer[]
  riders         DeliveryRider[]
  qualityChecks  QualityCheck[]
  payrollStubs   PayrollStub[]
  handovers      ShiftHandover[]
  notifications  OpsNotification[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  type        String    @default("FINISHED")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  uom         String    @default("pcs")
  listPrice   Float     @default(0)
  costPrice   Float     @default(0)
  trackStock  Boolean   @default(true)
  isSellable  Boolean   @default(true)
  isPublic    Boolean   @default(true)
  allergens   String?
  barcode     String?
  active      Boolean   @default(true)
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipeItems     RecipeItem[]        @relation("ParentProduct")
  usedInRecipes   RecipeItem[]        @relation("IngredientProduct")
  inventory       InventoryItem[]
  lots            InventoryLot[]
  priceOverrides  PriceOverride[]
  saleLines       SaleLine[]
  transferLines   StockTransferLine[]
  productionLines ProductionLine[]
  wastage         WastageRecord[]
  onlineLines     OnlineOrderLine[]
  purchaseLines   PurchaseOrderLine[]
  promotionItems  PromotionItem[]

  @@index([barcode])
}

model RecipeItem {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation("ParentProduct", fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Product @relation("IngredientProduct", fields: [ingredientId], references: [id])
  quantity     Float
  yieldFactor  Float   @default(1)

  @@unique([productId, ingredientId])
}

model InventoryItem {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Float    @default(0)
  reservedQty  Float    @default(0)
  reorderLevel Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([branchId, productId])
}

model InventoryLot {
  id         String    @id @default(cuid())
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  lotNo      String
  quantity   Float     @default(0)
  expiryDate DateTime?
  receivedAt DateTime  @default(now())
  sourceType String?
  sourceId   String?

  @@index([branchId, productId, expiryDate])
}

model PosShift {
  id          String    @id @default(cuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  tillNo      String    @default("TILL-1")
  cashierId   String
  cashier     User      @relation(fields: [cashierId], references: [id])
  status      String    @default("OPEN")
  openingCash Float     @default(0)
  closingCash Float?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  notes       String?
  sales       Sale[]

  @@index([branchId, status])
}

model PriceOverride {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Float

  @@unique([branchId, productId])
}

model StockTransfer {
  id            String    @id @default(cuid())
  transferNo    String    @unique
  fromBranchId  String
  fromBranch    Branch    @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId    String
  toBranch      Branch    @relation("TransferTo", fields: [toBranchId], references: [id])
  status        String    @default("DRAFT")
  notes         String?
  createdById   String?
  createdBy     User?     @relation("TransferCreatedBy", fields: [createdById], references: [id])
  shippedById   String?
  shippedBy     User?     @relation("TransferShippedBy", fields: [shippedById], references: [id])
  receivedById  String?
  receivedBy    User?     @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  createdAt     DateTime  @default(now())
  shippedAt     DateTime?
  receivedAt    DateTime?
  lines         StockTransferLine[]
}

model StockTransferLine {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Float
  shippedQty  Float         @default(0)
  receivedQty Float         @default(0)
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases PurchaseOrder[]
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  poNo          String   @unique
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  status        String   @default("DRAFT")
  notes         String?
  subtotal      Float    @default(0)
  total         Float    @default(0)
  createdById   String?
  createdBy     User?    @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  receivedById  String?
  receivedBy    User?    @relation("PurchaseReceivedBy", fields: [receivedById], references: [id])
  orderedAt     DateTime @default(now())
  receivedAt    DateTime?
  lines         PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  purchaseId  String
  purchase    PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Float
  receivedQty Float         @default(0)
  unitCost    Float         @default(0)
  lineTotal   Float         @default(0)
}

model Sale {
  id            String    @id @default(cuid())
  saleNo        String    @unique
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  cashierId     String?
  cashier       User?     @relation(fields: [cashierId], references: [id])
  shiftId       String?
  shift         PosShift? @relation(fields: [shiftId], references: [id])
  tillNo        String?
  channel       String    @default("POS")
  subtotal         Float
  tax              Float     @default(0)
  discount         Float     @default(0)
  loyaltyRedeemed  Int       @default(0)
  total            Float
  paymentMethod    String    @default("CASH")
  voided           Boolean   @default(false)
  voidReason       String?
  offlineKey       String?   @unique
  createdAt        DateTime  @default(now())
  lines            SaleLine[]
  onlineOrder      OnlineOrder?
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
}

model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  lineTotal Float
}

model DayClose {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  closedById   String?
  closedBy     User?    @relation(fields: [closedById], references: [id])
  businessDate DateTime
  cashExpected Float
  cashCounted  Float
  cardTotal    Float    @default(0)
  saleCount    Int
  saleTotal    Float
  variance     Float
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([branchId, businessDate])
}

model ProductionBatch {
  id          String    @id @default(cuid())
  batchNo     String    @unique
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  status      String    @default("PLANNED")
  plannedDate DateTime
  notes       String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  lines       ProductionLine[]
}

model ProductionLine {
  id         String          @id @default(cuid())
  batchId    String
  batch      ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  plannedQty Float
  actualQty  Float           @default(0)
}

model WastageRecord {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Float
  reason       String
  category     String   @default("SPOILAGE") // SPOILAGE | EXPIRED | DAMAGE | UNSOLD | OTHER
  unitCost     Float    @default(0)
  costTotal    Float    @default(0)
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
}

model OnlineOrder {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  customerName  String
  customerPhone String
  customerEmail String?
  fulfillment   String   @default("PICKUP")
  address       String?
  status        String   @default("PENDING")
  subtotal      Float
  total         Float
  notes         String?
  externalChannel String @default("WEB") // WEB | FOODPANDA | CAREEM | MANUAL
  externalRef   String?
  riderId       String?
  rider         DeliveryRider? @relation(fields: [riderId], references: [id])
  deliveryStatus String? // ASSIGNED | OUT_FOR_DELIVERY | DELIVERED | FAILED
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  saleId        String?  @unique
  sale          Sale?    @relation(fields: [saleId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lines         OnlineOrderLine[]
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  @@index([externalChannel, externalRef])
}

model OnlineOrderLine {
  id        String      @id @default(cuid())
  orderId   String
  order     OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  lineTotal Float
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  branchId   String?
  summary    String
  meta       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Customer {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String
  email         String?
  city          String?
  birthday      DateTime?
  notes         String?
  loyaltyPoints Int      @default(0)
  preferredBranchId String?
  preferredBranch   Branch? @relation(fields: [preferredBranchId], references: [id])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sales         Sale[]
  orders        OnlineOrder[]
  loyaltyLedger LoyaltyLedger[]
}

model LoyaltyLedger {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  delta      Int
  reason     String
  saleId     String?
  createdAt  DateTime @default(now())
}

model Promotion {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  type        String    @default("PERCENT") // PERCENT | FIXED | BRANCH_PRICE
  value       Float
  city        String?
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean   @default(true)
  notes       String?
  createdById String?
  createdBy   User?     @relation("PromotionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  items       PromotionItem[]
}

model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

model Attendance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  workDate   DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String   @default("PRESENT") // PRESENT | ABSENT | LATE
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([userId, workDate])
}

model DeliveryRider {
  id        String   @id @default(cuid())
  name      String
  phone     String
  vehicle   String?
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    OnlineOrder[]
}

model MobileApiToken {
  id        String   @id @default(cuid())
  token     String   @unique
  label     String
  role      String   @default("BRANCH_MANAGER")
  branchId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
}

/// Food safety / HACCP-style checks (company-owned ops — Phase 5)
model QualityCheck {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  checkType    String   // TEMP | CLEANING | RECEIVING | RECALL | EQUIPMENT
  title        String
  status       String   @default("PASS") // PASS | FAIL | PENDING
  value        Float?   // e.g. temperature °C
  unit         String?
  relatedLotId String?
  notes        String?
  checkedById  String?
  checkedBy    User?    @relation(fields: [checkedById], references: [id])
  checkedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([branchId, checkedAt])
  @@index([checkType, status])
}

/// Light payroll stubs for export to external payroll (Phase 5)
model PayrollStub {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  basePay     Float    @default(0)
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  daysPresent Int      @default(0)
  status      String   @default("DRAFT") // DRAFT | EXPORTED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([periodStart, periodEnd])
  @@index([branchId])
}

/// Phase 6 — shift handover / till reconciliation
model ShiftHandover {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  fromUserId    String
  fromUser      User      @relation("HandoverFrom", fields: [fromUserId], references: [id])
  toUserId      String?
  toUser        User?     @relation("HandoverTo", fields: [toUserId], references: [id])
  shiftId       String?
  tillNo        String?
  expectedCash  Float     @default(0)
  countedCash   Float     @default(0)
  variance      Float     @default(0)
  salesTotal    Float     @default(0)
  saleCount     Int       @default(0)
  wastageQty    Float     @default(0)
  openOrders    Int       @default(0)
  notes         String?
  status        String    @default("OPEN") // OPEN | ACCEPTED | CLOSED
  createdAt     DateTime  @default(now())
  closedAt      DateTime?

  @@index([branchId, createdAt])
}

/// Phase 6 — ops alerts (low stock, overdue transfers, etc.)
model OpsNotification {
  id         String    @id @default(cuid())
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  severity   String    @default("WARN") // INFO | WARN | CRITICAL
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  readById   String?
  readBy     User?     @relation("NotificationReader", fields: [readById], references: [id])
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt, severity])
}

/// Phase 6 — HQ scheduled export presets (manual run / CSV packs)
model ReportPreset {
  id          String   @id @default(cuid())
  name        String
  reportType  String   // SCOREBOARD | WASTAGE | SUPPLIERS | SALES | HANDOVER
  cadence     String   @default("DAILY") // DAILY | WEEKLY | ON_DEMAND
  active      Boolean  @default(true)
  notes       String?
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
}

